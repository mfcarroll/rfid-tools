#!/usr/bin/env python3
"""Save the Flipper's screen as a PNG, and press its buttons, over the RPC that qFlipper uses.

    ./flipper_screen shot.png
    ./flipper_screen shot.png --press ok --press back:long --wait 2
    ./flipper_screen shot.png --text          # also print the screen as text

Each --press is KEY or KEY:long, KEY one of up, down, left, right, ok, back. Presses run in order, then the
tool waits --wait seconds and takes the shot. The port comes from FLIPPER_PORT in `.env` unless `--port` is given.
Close qFlipper and any web page holding the port first.
"""
import argparse
import os
import struct
import sys
import time
import zlib

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
from benchmatrix.bootstrap import ensure  # noqa: E402

ensure(HERE)
import serial  # noqa: E402
from benchmatrix.setup import load_env  # noqa: E402

KEYS = {"up": 0, "down": 1, "right": 2, "left": 3, "ok": 4, "back": 5}
PRESS, RELEASE, SHORT, LONG = 0, 1, 2, 3
W, H = 128, 64


def varint(n):
    out = b""
    while True:
        b = n & 0x7F
        n >>= 7
        if n:
            out += bytes([b | 0x80])
        else:
            return out + bytes([b])


def field(num, payload):
    """A length-delimited protobuf field."""
    return varint(num << 3 | 2) + varint(len(payload)) + payload


def main_msg(command_id, num, payload=b""):
    body = varint(1 << 3) + varint(command_id) + field(num, payload)
    return varint(len(body)) + body


def read_varint(s):
    n = shift = 0
    while True:
        c = s.read(1)
        if not c:
            raise TimeoutError("no reply from the Flipper")
        n |= (c[0] & 0x7F) << shift
        if not c[0] & 0x80:
            return n
        shift += 7


def fields(buf):
    """Yield (number, value) for each field. Length-delimited values are bytes, varints are ints."""
    i = 0
    while i < len(buf):
        tag, i = decode_varint(buf, i)
        num, wire = tag >> 3, tag & 7
        if wire == 0:
            val, i = decode_varint(buf, i)
        elif wire == 2:
            n, i = decode_varint(buf, i)
            val, i = buf[i : i + n], i + n
        else:
            raise ValueError(f"wire type {wire}")
        yield num, val


def decode_varint(buf, i):
    n = shift = 0
    while True:
        b = buf[i]
        i += 1
        n |= (b & 0x7F) << shift
        if not b & 0x80:
            return n, i
        shift += 7


def read_frame(s, deadline):
    while time.time() < deadline:
        msg = s.read(read_varint(s))
        for num, val in fields(msg):
            if num == 22:
                return dict(fields(val)).get(1, b"")
    raise TimeoutError("no screen frame")


def pixels(data):
    # u8g2 tiles: 8 rows of 128 bytes, each byte a column of 8 pixels, lowest bit on top
    return [[data[(y // 8) * W + x] >> (y % 8) & 1 for x in range(W)] for y in range(H)]


def write_png(path, px, scale=4):
    orange, black = (254, 138, 44), (0, 0, 0)  # qFlipper's screenshot colours
    rows = b""
    for row in px:
        line = b"".join(bytes(black if p else orange) * scale for p in row)
        rows += (b"\x00" + line) * scale

    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))

    ihdr = struct.pack(">IIBBBBB", W * scale, H * scale, 8, 2, 0, 0, 0)
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(rows)) + chunk(b"IEND", b""))


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("out", help="PNG to write")
    parser.add_argument("--port", help="Flipper serial port (default FLIPPER_PORT from .env)")
    parser.add_argument("--press", action="append", default=[], help="KEY or KEY:long, in order")
    parser.add_argument("--wait", type=float, default=0.5, help="seconds between the last press and the shot")
    parser.add_argument("--text", action="store_true", help="also print the screen as text")
    args = parser.parse_args()

    port = args.port or load_env().get("FLIPPER_PORT")
    if not port:
        raise SystemExit("No Flipper port. Pass --port, or run ./bench setup.")
    s = serial.Serial(port, 230400, timeout=2)
    s.write(b"\x03\r")
    time.sleep(0.3)
    s.reset_input_buffer()
    s.write(b"start_rpc_session\r")
    s.read_until(b"\n")  # the command's echo
    cid = 1
    try:
        for p in args.press:
            key, _, kind = p.partition(":")
            events = (PRESS, LONG, RELEASE) if kind == "long" else (PRESS, SHORT, RELEASE)
            for ev in events:
                cid += 1
                s.write(main_msg(cid, 23, varint(1 << 3) + varint(KEYS[key]) + varint(2 << 3) + varint(ev)))
                time.sleep(0.6 if kind == "long" and ev == PRESS else 0.05)
        time.sleep(args.wait)
        s.reset_input_buffer()
        cid += 1
        s.write(main_msg(cid, 20))
        data = read_frame(s, time.time() + 5)
        cid += 1
        s.write(main_msg(cid, 21))
    finally:
        cid += 1
        s.write(main_msg(cid, 19))
        time.sleep(0.3)
        s.close()
    px = pixels(data)
    write_png(args.out, px)
    if args.text:
        for y in range(0, H, 2):
            print("".join("█" if px[y][x] or px[y + 1][x] else " " for x in range(W)).rstrip())


if __name__ == "__main__":
    main()
